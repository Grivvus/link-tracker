{
  "uid": "bot-command-metrics",
  "title": "bot command metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Command Requests Rate",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (command) (rate(bot_command_requests_total{job=\"prometheus-bot\"}[5m]))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Command Duration p50",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum by (scope, scope_type, le) (rate(bot_command_duration_ms_total_bucket{job=\"prometheus-bot\"}[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Command Duration p95",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (scope, scope_type, le) (rate(bot_command_duration_ms_total_bucket{job=\"prometheus-bot\"}[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Command Duration p99",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum by (scope, scope_type, le) (rate(bot_command_duration_ms_total_bucket{job=\"prometheus-bot\"}[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sent Notifications Rate",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(bot_sent_notification_total{job=\"prometheus-bot\"}[5m]))",
          "legendFormat": "sent notifications",
          "refId": "A"
        }
      ]
    }
  ]
}
