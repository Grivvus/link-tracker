{
  "uid": "scrapper-business-metrics",
  "title": "scrapper business metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Links On Track",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "scrapper_links_on_track_total{job=\"prometheus-scrapper\"}",
          "legendFormat": "{{tracked_source}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Requests Rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (method, route) (rate(scrapper_http_requests_total{job=\"prometheus-scrapper\"}[5m]))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Duration p50",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum by (scope, scope_type, le) (rate(scrapper_request_duration_ms_total_bucket{job=\"prometheus-scrapper\"}[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Duration p95",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (scope, scope_type, le) (rate(scrapper_request_duration_ms_total_bucket{job=\"prometheus-scrapper\"}[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Duration p99",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum by (scope, scope_type, le) (rate(scrapper_request_duration_ms_total_bucket{job=\"prometheus-scrapper\"}[5m])))",
          "legendFormat": "{{scope}} {{scope_type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
