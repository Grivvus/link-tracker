FROM golang:1.26 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN GOOS=linux go build -o scrapper ./cmd/scrapper/

FROM alpine:latest

RUN apk --no-cache add ca-certificates

COPY --from=builder /app/scrapper /usr/bin/scrapper
COPY --from=builder /app/.env /.env
RUN chmod +x /usr/bin/scrapper

ENTRYPOINT ["/usr/bin/scrapper"]
